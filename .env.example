# ==============================================================================
# CONNECTED ENTERPRISE ERP & CRM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Security
SECRET_KEY=change-this-to-a-secure-random-32-character-secret-key
FLASK_ENV=development
DEBUG=True

# Database Configuration (Supports SQLite for quick demo or MySQL in production)
# SQLite (Default for quick demo):
SQLALCHEMY_DATABASE_URI=sqlite:///instance/app.db
# MySQL (Production):
# SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:password@localhost:3306/connected_erp?charset=utf8mb4

SQLALCHEMY_TRACK_MODIFICATIONS=False

# Email / SMTP Settings
MAIL_ENABLED=0
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=noreply@empresa.com.br
MAIL_PASSWORD=your_email_password_here
MAIL_DEFAULT_SENDER="Connected ERP <noreply@empresa.com.br>"
MAIL_BASE_URL=http://localhost:5000

# File Upload Settings
MAX_CONTENT_MB=20
MAX_CONTENT_LENGTH_MB=25
UPLOADS_DIR=uploads

# Company Profile & Branding
COMPANY_NAME=Connected Enterprise
COMPANY_EMAIL=contato@empresa.com.br
COMPANY_PHONE=(11) 3000-0000
COMPANY_SITE=www.empresa.com.br
